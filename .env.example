# ---------------------------------------------------------------------------
# Alpha Trading Platform - example environment file
#
# Copy to `.env` and fill in. Every value below is the shipped default when
# the key is absent or blank, so an empty copy boots the product fully
# disconnected: no market data, no broker, no signals, no orders.
#
# Secrets are never echoed back by the API, logs, or readiness output.
# ---------------------------------------------------------------------------

# --- Server ---------------------------------------------------------------
# The server refuses to bind off the loopback interface unless
# ALLOW_NON_LOCALHOST=true is also set.
APP_HOST=127.0.0.1
APP_PORT=8000
APP_ENV=development
ALLOW_NON_LOCALHOST=false
DATABASE_PATH=data/alpha_trading.sqlite3

# Leave blank to disable owner controls. Set a unique local secret before
# enabling them. Required for every state-changing request except the
# TradingView webhook, which authenticates with its own shared secret.
OWNER_CONTROL_TOKEN=
REQUIRE_API_AUTH=false

# --- Trading mode ---------------------------------------------------------
# BACKTEST | PAPER | LIVE. LIVE also requires LIVE_TRADING_ENABLED=true,
# and the broker adapter must be configured and out of any sandbox gate.
TRADING_MODE=PAPER
LIVE_TRADING_ENABLED=false

# Universe scanned for setups. Prices must stay strictly below
# MAX_CANDIDATE_PRICE or the candidate is rejected before any risk check.
UNIVERSE=AAPL,BAC,F,PLTR,SOFI
MAX_CANDIDATE_PRICE=100
PAPER_STARTING_CASH=100000
SCAN_INTERVAL_SECONDS=30
HISTORY_LOOKBACK_DAYS=90

# --- Market data ----------------------------------------------------------
# polygon | alphavantage | none   ("MOCK"/"TEST"/"LOCAL" resolve to none)
# Each provider reads only its own key below; see docs/MARKET_DATA.md.
# Credentials alone never report CONNECTED - the backend records real
# connectivity (CONNECTED / STALE / RATE_LIMITED / UNAVAILABLE) per request.
MARKET_DATA_PROVIDER=none
MARKET_DATA_BASE_URL=
MARKET_DATA_PLAN=
MARKET_DATA_ACCOUNT_ID=
POLYGON_API_KEY=
ALPHAVANTAGE_API_KEY=
# Legacy aliases, still honoured:
MARKET_DATA_API_KEY=
MARKET_DATA_API_SECRET=
MARKET_DATA_MODE=
# 1min | 5min | 15min | 1h | 1day (polygon)   1min | 5min | 15min | 30min | 60min | daily (alphavantage)
MARKET_DATA_TIMEFRAME=1min
# A quote older than this is reported STALE, never FRESH. Automatic
# stop-loss/take-profit evaluation is disabled while a position is stale.
MARKET_DATA_STALE_AFTER_SECONDS=300
# Per-request timeout for provider HTTP calls (seconds, must be > 0).
MARKET_DATA_TIMEOUT_SECONDS=10

# --- Broker ---------------------------------------------------------------
# alpaca | none   ("mock"/"local" resolve to none)
TRADING_PLATFORM_PROVIDER=none
# SANDBOX -> paper-api.alpaca.markets   LIVE -> api.alpaca.markets
TRADING_PLATFORM_ENVIRONMENT=SANDBOX
TRADING_PLATFORM_NAME=
TRADING_PLATFORM_BASE_URL=
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_ACCOUNT_ID=
# Legacy aliases, still honoured:
TRADING_PLATFORM_ADAPTER=
TRADING_PLATFORM_API_KEY=
TRADING_PLATFORM_API_SECRET=
TRADING_PLATFORM_ACCOUNT_ID=

# --- TradingView webhook --------------------------------------------------
# Required before the endpoint accepts any alert. The endpoint authenticates
# with this secret alone and does not use OWNER_CONTROL_TOKEN.
# TRADINGVIEW_WEBHOOK_SECRET is used for both the X-Webhook-Signature HMAC
# header and an optional payload "secret" field; secret values are never
# echoed back by the API, logs, or readiness output.
TRADINGVIEW_ENABLED=false
TRADINGVIEW_WEBHOOK_SECRET=
# Optional allowlist; blank accepts any supported strategy identifier.
TRADINGVIEW_ALLOWED_STRATEGIES=
# Rejects alerts with a timestamp older than this many seconds or further than
# 60 seconds in the future. Timestamps without an offset are read as UTC.
TRADINGVIEW_MAX_SIGNAL_AGE_SECONDS=300
# CONNECTED requires an accepted signal inside this window; older traffic is
# reported STALE. Seconds.
TRADINGVIEW_STALE_AFTER_SECONDS=86400
# Largest accepted request body in bytes (1..65536); larger bodies are 413.
TRADINGVIEW_MAX_BODY_BYTES=8192

# --- AI -------------------------------------------------------------------
# local | none | openai_compatible
# Only "local" is implemented today; anything else is reported as
# NOT_CONFIGURED rather than failing the request.
AI_PROVIDER=local
AI_MODEL=local-deterministic
AI_BASE_URL=
AI_API_KEY=
AI_ENABLED=true

# --- Notifications --------------------------------------------------------
# local | webhook | discord | telegram
NOTIFICATION_PROVIDER=local
NOTIFICATION_ENABLED=true
NOTIFICATION_DESTINATION=
NOTIFICATION_TOKEN=
NOTIFICATION_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Risk limits ----------------------------------------------------------
# Configuration may only tighten these. Values outside the documented range
# are rejected at startup instead of silently widening a safety limit.
RISK_ENABLED=true
RISK_FRACTION=0.01
RISK_MAX_PER_TRADE=0.01
RISK_MAX_RISK_AMOUNT=
RISK_MAX_POSITION_NOTIONAL=25000
RISK_MAX_PORTFOLIO_EXPOSURE=0.50
RISK_MAX_POSITIONS=5
RISK_MAX_DAILY_LOSS_FRACTION=0.03
RISK_MIN_REWARD_RISK=2.0
RISK_ALLOW_DUPLICATE_SYMBOL=false
# Phase 8 hardening limits (see docs/PIPELINE.md "Risk controls").
# Absolute share ceiling for one order; never widened by configuration.
RISK_MAX_QUANTITY=10000
# Maximum gross notional for one symbol, including any existing position.
RISK_MAX_SYMBOL_EXPOSURE=25000
# Entry-price ceiling enforced by the risk layer. The effective limit is the
# lower of this value and MAX_CANDIDATE_PRICE; risk may only tighten it.
RISK_MAX_ENTRY_PRICE=100
# When true, new risk approvals require every open position to carry a FRESH
# real quote (UNPRICED/STALE positions then block new entries). Default false
# because unpriced positions already contribute zero market value to equity.
RISK_REQUIRE_FRESH_VALUATION=false

# --- Strategy -------------------------------------------------------------
# Values below are the shipped defaults; omit these keys to use them.
STRATEGY_FAST_EMA=20
STRATEGY_SLOW_EMA=50
STRATEGY_RSI_PERIOD=14
STRATEGY_ATR_PERIOD=14
STRATEGY_ATR_MULTIPLIER=2.0
# Fraction of entry price, not a percentage: 0.0263 == 2.63%.
STRATEGY_MAX_STOP_DISTANCE_PCT=0.02631578947368421
STRATEGY_MIN_REWARD_RISK=2.0
STRATEGY_BULLISH_RSI_MIN=50
STRATEGY_BULLISH_RSI_MAX=70
STRATEGY_BEARISH_RSI_MIN=30
STRATEGY_BEARISH_RSI_MAX=50
